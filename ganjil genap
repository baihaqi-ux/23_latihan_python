while True:
    input_user = input("Masukkan angka (atau ketik 'keluar' untuk berhenti): ")

    # Pintu keluar untuk menghentikan program
    if input_user.lower() == 'keluar':
        print("Program dihentikan. Selesai!")
        break

    # Memastikan bahwa yang diinput adalah angka
    if input_user.isdigit():
        angka = int(input_user)
        # Pengecekan Ganjil / Genap
        if angka % 2 == 0:
            print(f"-> Angka {angka} adalah GENAP\n")
        else:
            print(f"-> Angka {angka} adalah GANJIL\n")
    else:
        print(" Harap masukkan angka yang valid!\n")